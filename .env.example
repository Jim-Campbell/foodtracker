# Required
DATABASE_URL=postgres://localhost:5432/food?sslmode=disable
FOOD_API_KEY=changeme

# Required for AI meal parsing
ANTHROPIC_API_KEY=

# Required for USDA FoodData Central nutrition lookups
FDC_API_KEY=

# Optional — defaults to claude-sonnet-5
AI_MODEL=

# Optional — defaults to 8082
PORT=8082

# Optional — photo features disabled until all five R2_* vars are set
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
